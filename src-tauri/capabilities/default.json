{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$RESOURCE/**" }]
    },
    "dialog:default",
    "dialog:allow-open",
    "notification:default",
    "autostart:default",
    "log:default"
  ]
}
