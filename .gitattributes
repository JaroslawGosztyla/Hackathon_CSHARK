# Normalize line endings: LF in the repo and in working trees on every OS.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.ogg  binary
*.mp3  binary
*.flac binary
*.wav  binary
*.woff binary
*.woff2 binary
*.ttf  binary

# Generated files: collapsed in GitHub diffs
src/lib/bindings/** linguist-generated=true
Cargo.lock        linguist-generated=true
package-lock.json linguist-generated=true
